  "last_reviewed": "2026-08-01",
  "purpose": "用可复核的三维评分和传输闸门评估 RSS 来源，不把媒体品牌、聚合地址和当前抓取成功混为同一指标。",
  "dimensions": {
    "quality": {
      "weight": 0.4,
      "scale": "1-5",
      "rule": "原创性、编辑规范、事实核验、上下文完整度和专业深度。"
    },
    "authority": {
      "weight": 0.4,
      "scale": "1-5",
      "rule": "通讯社、公共机构、专业机构、区域媒体或垂直媒体在对应领域的可信身份。"
    },
    "freshness": {
      "weight": 0.2,
      "scale": "0-5",
      "rule": "根据实时抓取时最新条目的年龄，与该来源 cadence_target_hours 比较。"
    }
  },
  "freshness_score": {
    "5": "最新条目不超过目标间隔",
    "4": "不超过目标间隔的 2 倍",
    "3": "不超过目标间隔的 4 倍",
    "2": "不超过目标间隔的 7 倍",
    "1": "超过目标间隔的 7 倍",
    "0": "抓取失败、无法解析或没有有效条目"
  },
  "decision_thresholds": {
    "core": 4.0,
    "supplement": 3.2,
    "fallback_only": 2.5,
    "repair": 2.5
  },
